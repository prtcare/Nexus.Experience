# The two backends the frontend talks to: the product API (Chat Core) and the
# Developer API (Features/Issues/Tasks + ObjectChatLinks). These are the only
# URLs the frontend may know - Intelligence and Platform URLs must never appear
# here.
VITE_NEXUS_API_URL=https://localhost:7205
VITE_NEXUS_DEVELOPER_API_URL=https://localhost:7295
